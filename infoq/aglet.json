{
  "id": "infoq",
  "name": {
    "default": "InfoQ 中文",
    "en": "InfoQ Chinese",
    "zh": "InfoQ 中文",
    "ja": "InfoQ 中国語"
  },
  "description": {
    "default": "InfoQ Chinese recommended articles from RSSHub.",
    "en": "InfoQ Chinese recommended articles from RSSHub.",
    "zh": "基于 RSSHub 的 InfoQ 中文推荐文章。",
    "ja": "RSSHub から InfoQ 中国語のおすすめ記事を表示します。"
  },
  "docs": "# InfoQ 中文\n\nInfoQ 中文推荐阅读小工具。后台 job 从 RSSHub 拉取 feed：\n\n- `https://rsshub.rssforever.com/infoq/recommend` → 推荐文章\n\n优先使用 `xml` wasm plugin 的 `xml.rss` 解析 RSS；开发时用 `aglet dev infoq --link <xml-plugin-dir>`。\n",
  "version": "0.1.1",
  "min_runtime": "0.1.7",
  "license": "MIT",
  "renderer": "auto",
  "author": "aglet-dev",
  "category": "media",
  "keywords": [
    "infoq",
    "rss",
    "articles",
    "developer",
    "chinese"
  ],
  "icon": "https://api.iconify.design/ph/newspaper-clipping-fill.svg?color=%230f766e&width=256",
  "permissions": [
    "data:read",
    "data:write"
  ],
  "requires": [
    {
      "plugin": "xml",
      "range": ">=0.1.0"
    }
  ],
  "window": {
    "style": "phone",
    "width": 420,
    "height": 820,
    "resizable": false
  },
  "jobs": [
    {
      "id": "ingest",
      "run": "ingest",
      "every": 300000,
      "while": "always"
    }
  ],
  "collections": {
    "recommended_articles": {
      "schema": {
        "guid": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "summary": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string" },
        "categories": { "type": "string" },
        "published_at": { "type": "string" },
        "published_ts": { "type": "number" },
        "source": { "type": "string" }
      },
      "indexes": ["guid", "published_ts", "category", "author"]
    }
  },
  "state": {
    "sync_error": ""
  }
}
